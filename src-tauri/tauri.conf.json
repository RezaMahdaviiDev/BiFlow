{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BiFlow",
  "version": "1.1.8",
  "identifier": "app.biflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm bundle:check && pnpm --dir apps/desktop dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm bundle:check && pnpm --dir apps/desktop build",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "BiFlow",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../resources/rules/": "rules/",
      "../resources/licenses/": "licenses/"
    },
    "category": "Utility",
    "shortDescription": "Safe Iran split routing through Hiddify",
    "longDescription": "Routes Iranian traffic directly and other traffic through an existing Hiddify connection using a privileged helper.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://updates.biflow.example/stable/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dialog": false,
      "pubkey": "REPLACE_WITH_RELEASE_PUBLIC_KEY"
    }
  }
}
